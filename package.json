{
  "name": "temporal-test-kit",
  "version": "0.1.0",
  "description": "Project-independent Temporal best-practices compliance auditor (CLI)",
  "type": "module",
  "bin": {
    "temporal-test-kit": "./bin/temporal-test-kit.js"
  },
  "main": "./dist/cli.js",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json && npm run copy-fixtures",
    "copy-fixtures": "mkdir -p dist/engines/dynamic/checks/fixtures && cp src/engines/dynamic/checks/fixtures/*.ts dist/engines/dynamic/checks/fixtures/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@temporalio/activity": "^1.23.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/common": "^1.23.0",
    "@temporalio/testing": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
